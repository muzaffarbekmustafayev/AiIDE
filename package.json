{
  "name": "aiide",
  "version": "1.0.0",
  "description": "AI IDE - Cloud Developer Workspace",
  "private": true,
  "bin": {
    "mzfck": "bin/mzfck.js"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,cyan \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "vite": "^6.0.7"
  }
}
